{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/venue/:id", "destination": "/api/venue?id=:id" },
    { "source": "/v/:id", "destination": "/api/venue?id=:id" }
  ],
  "functions": {
    "api/venue-image.js": { "includeFiles": "api/_fonts/*" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "open-finds-2.vercel.app"
        }
      ],
      "destination": "https://www.theunsaved.app/:path*",
      "permanent": false
    }
  ]
}
